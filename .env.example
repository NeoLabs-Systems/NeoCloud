########################################
# NeoCloud configuration
#
# Lives at ~/.neocloud/.env (or $NEOCLOUD_HOME/.env). `neocloud setup` and
# the first server start create it and fill in the secrets below. Change
# values with `neocloud env set KEY VALUE` or by editing the file, then run
# `neocloud restart`. Settings marked (admin) can also be changed in the
# app's Admin page; the app writes them back to this file.
########################################


########################################
# Core runtime
########################################

PORT=3344
NODE_ENV=production

# Signs session cookies. Auto-generated if left blank. Changing it signs
# everyone out.
SESSION_SECRET=

# Encrypts every stored file (through a per-account key) and the 2FA seeds.
# Auto-generated ONCE on first start: 64 hex characters.
#
#   !!! BACK THIS UP (`neocloud keys export`) AND NEVER CHANGE IT. !!!
#
# Without this exact key, the files in the storage directory -- and every
# backup of them -- can never be decrypted again.
NEOCLOUD_MASTER_KEY=

# Where everything lives. Defaults: ~/.neocloud, its data/ folder, and
# data/storage for the encrypted file blobs. Point NEOCLOUD_STORAGE_DIR at a
# bigger disk to keep files apart from the database.
# NEOCLOUD_HOME=
# NEOCLOUD_DATA_DIR=
# NEOCLOUD_STORAGE_DIR=


########################################
# Network
########################################

# The address people open NeoCloud at, when it sits behind a reverse proxy.
# Example: https://cloud.example.com
# An https:// URL turns on secure cookies and proxy trust automatically.
PUBLIC_URL=

# Every browser origin allowed to use the API, comma-separated. Empty allows
# only localhost. Add your LAN address and public domain here, e.g.
# http://192.168.1.20:3344,https://cloud.example.com
ALLOWED_ORIGINS=

# Override what PUBLIC_URL implies (true/false).
# SECURE_COOKIES=
# Which reverse proxies may set X-Forwarded-For/-Proto (client address for
# rate limits and the audit log, https detection): true/false, a hop count
# (2 for Cloudflare in front of nginx), or proxy addresses/subnets,
# comma-separated (172.18.0.1,loopback). Default when PUBLIC_URL is https:
# loopback,linklocal,uniquelocal (a proxy on this host or a private network,
# the Docker bridge included); else none. A hop count trusts any peer that
# reaches the port directly, so keep 3344 reachable only from the proxy.
# See docs/operations.md.
# TRUST_PROXY=

# HSTS max-age in seconds when secure cookies are on.
# NEOCLOUD_HSTS_MAX_AGE=86400

# The Flutter web app loads its rendering engine and fonts from Google's CDN.
# Set false for a strict CSP if you self-host those assets.
# NEOCLOUD_CSP_ALLOW_EXTERNAL=true


########################################
# Accounts & access
########################################

# The first account registered becomes admin. Grant more with
# `neocloud admin grant <username>`, in the Admin page, or list usernames
# here (comma-separated) to grant them on every start. Removing a name does
# not revoke admin.
# NEOCLOUD_ADMIN_USERS=

# (admin) Open sign-up. Set false to refuse new registrations; the first
# account on a fresh install can always register.
NEOCLOUD_ALLOW_SIGNUP=true


########################################
# Storage policy (all admin-editable)
########################################

# Storage each account gets unless an admin sets its own limit.
# A size (500MB, 10GB, 2TB) or "unlimited". Default 10GB.
NEOCLOUD_DEFAULT_QUOTA=10GB

# Largest single file. A size, or 0 for no limit beyond the quota.
NEOCLOUD_MAX_UPLOAD_SIZE=0

# Days deleted items stay in the trash before they are removed for good.
# 0 keeps them until emptied by hand.
NEOCLOUD_TRASH_RETENTION_DAYS=30

# Uploads are refused (507 DISK_FULL) while the storage disk has less free
# space than this, so a full disk never damages the database. A size.
# NEOCLOUD_MIN_FREE_DISK=1GB

# Previous versions kept per file when it is replaced. Versions count
# toward the account's quota. 0 keeps none.
NEOCLOUD_VERSION_RETENTION=10


########################################
# Previews
########################################

# Image thumbnails are always on and never touch the disk unencrypted.
# Office documents (docx, xlsx, pptx, odt, ...) are previewed as PDF when
# LibreOffice is installed. LibreOffice reads from a file, so each document
# is decrypted into a private temporary folder for the few seconds the
# conversion takes. Set false to keep every byte encrypted on disk.
NEOCLOUD_OFFICE_PREVIEW=true

# Where LibreOffice lives, if `soffice` is not on the PATH.
# NEOCLOUD_LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice

# On Linux, LibreOffice runs without network access when bwrap or unshare can
# create a network namespace on this host (auto). off runs it without that.
# It always gets a minimal environment and a profile with links and macros
# off; see SECURITY.md.
# NEOCLOUD_PREVIEW_SANDBOX=auto

# Full-text search over file contents (Admin > settings writes this). The
# index lives in the database: it reveals which words each file contains to
# anyone holding the database (see SECURITY.md). PDFs are read by
# `pdftotext` (poppler-utils) when installed, else by a bundled extractor.
NEOCLOUD_FULL_TEXT_SEARCH=false


########################################
# Backups
########################################

# Backup targets (folder/NAS, SFTP, S3, WebDAV) and their schedules are set in
# the app under Admin › Backups and stored encrypted in the database.
# Restoring needs the server stopped and the same NEOCLOUD_MASTER_KEY:
#   neocloud backup snapshots <target-id>
#   neocloud backup restore <target-id> <snapshot>
#   neocloud backup verify <target-id>
#
# While no target is scheduled, the server keeps a daily encrypted snapshot of
# the database (not the files) in data/backups (the last 14).
# See docs/operations.md.

# Imports from servers on a private network (LAN, localhost) are admin-only;
# set true to allow them for every account.
# NEOCLOUD_IMPORT_ALLOW_PRIVATE=false


########################################
# Node limits
########################################

# Every file and folder is a database row, and copies share their storage,
# so the number of nodes has limits of its own. Files and folders one
# account may hold, trash included (507 NODE_LIMIT beyond it).
# NEOCLOUD_MAX_NODES=1000000

# Files and folders one copy may create (413 COPY_TOO_LARGE beyond it).
# NEOCLOUD_MAX_COPY_NODES=50000


########################################
# AI (docs/ai.md)
########################################

# AI features for the whole server (Admin › AI writes this). Off by default;
# each person still opts in under Settings › AI.
# NEOCLOUD_AI_ENABLED=false

# Tokens one account may use per month (empty: no limit). Admins can set a
# different budget per account.
# NEOCLOUD_AI_MONTHLY_TOKENS=

# Server-wide provider credentials (Admin › AI › Providers writes these).
# NeoRouter is connected with its sign-in, which fills NEOROUTER_BASE_URL,
# NEOROUTER_API_KEY and NEOROUTER_ROLES.
# NEOCLOUD_OPENAI_API_KEY=
# NEOCLOUD_OPENAI_BASE_URL=
# NEOCLOUD_OPENAI_COMPATIBLE_API_KEY=
# NEOCLOUD_OPENAI_COMPATIBLE_BASE_URL=
# NEOCLOUD_ANTHROPIC_API_KEY=
# NEOCLOUD_ANTHROPIC_BASE_URL=
# NEOCLOUD_GOOGLE_AI_KEY=
# NEOCLOUD_OPENROUTER_API_KEY=
# NEOCLOUD_OLLAMA_URL=

# Model release dates, prices and image support come from OpenRouter's public
# model list (no key, nothing about your users). Set off to skip it.
# NEOCLOUD_AI_REFERENCE_URL=
