<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The transfer service: a data sync foreground service with a partial
         wakelock, only while files are being uploaded from the app. Background
         passes (CameraUploadWorker) run in WorkManager's foreground service,
         also as data sync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Receiving files in the background (HandoffService): a remote messaging
         foreground service (Android 14+; data sync before), see handoff/. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Re-arms the new-photo trigger and runs a pass after a reboot or an update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Asks for the battery optimisation exemption directly. Google Play
         restricts this to apps whose core function needs it; backing up
         the phone's photos in the background is NeoCloud's case. The
         exemption also lets a background pass start the transfer service. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application>
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <!-- "Receive files in the background": the live connection that brings
             "Send to device" offers while the app is closed. Not exported;
             only started by the app, a reboot or the 15-minute check. -->
        <service
            android:name=".handoff.HandoffService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging|dataSync"/>
        <!-- Accept and Decline on an offer's notification. -->
        <receiver
            android:name=".handoff.AnswerReceiver"
            android:exported="false"/>
        <!-- CameraUploadWorker's setForeground: Android 14+ needs the type
             declared on WorkManager's service. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge"/>
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <!-- Some manufacturers' fast boot. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>

    <!-- The manufacturers' autostart and battery screens ManufacturerSettings
         opens; Android 11+ hides other apps' activities without this. -->
    <queries>
        <package android:name="com.miui.securitycenter"/>
        <package android:name="com.miui.powerkeeper"/>
        <package android:name="com.huawei.systemmanager"/>
        <package android:name="com.hihonor.systemmanager"/>
        <package android:name="com.coloros.safecenter"/>
        <package android:name="com.oppo.safe"/>
        <package android:name="com.oplus.battery"/>
        <package android:name="com.oneplus.security"/>
        <package android:name="com.vivo.permissionmanager"/>
        <package android:name="com.iqoo.secure"/>
        <package android:name="com.samsung.android.lool"/>
        <package android:name="com.samsung.android.sm"/>
        <package android:name="com.asus.mobilemanager"/>
    </queries>
</manifest>
